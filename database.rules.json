{
  "rules": {
    ".read": "auth != null && root.child('admins').child(auth.uid).exists()",

    "owner": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((root.child('admins').child(auth.uid).exists() && !newData.exists() && root.child('owner').exists() && $uid !== root.child('owner').val()) || (auth.uid === $uid && !data.exists() && auth.token.email_verified === true && root.child('adminInvites').child(auth.token.email.replace('.', ',')).exists()))",
        ".validate": "newData.isString() && newData.val() === auth.token.email"
      }
    },

    "adminInvites": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$emailKey": {
        ".read": "auth != null && auth.token.email.replace('.', ',') === $emailKey",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!newData.exists() && auth.token.email_verified === true && auth.token.email.replace('.', ',') === $emailKey))",
        ".validate": "$emailKey.matches(/^[a-z0-9_%+,-]+@[a-z0-9,-]+$/) && $emailKey.length <= 254 &&newData.child('email').isString() && newData.child('email').val().replace('.', ',') === $emailKey && newData.child('invitedBy').isString()"
      }
    },

    "verifiedExempt": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "bookedSlots": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$slot": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && (auth.token.email_verified === true || root.child('verifiedExempt').child(auth.uid).exists()) && $slot.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}_([01][0-9]|2[0-3])(00|30)$/)) || (!newData.exists() && (data.val() === auth.uid || data.val() === true)))"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".validate": "newData.hasChildren()",
      "schedule": {
        ".validate": "newData.hasChildren()",
        "days": {
          ".validate": "newData.hasChildren()",
          "$dow": {
            ".validate": "$dow.matches(/^[0-6]$/) && newData.child('open').isBoolean() && (newData.child('open').val() === false || newData.child('times').hasChildren())",
            "open": { ".validate": "newData.isBoolean()" },
            "times": {
              "$t": { ".validate": "$t.matches(/^([01][0-9]|2[0-3])(00|30)$/) && newData.val() === true" }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      },
      "loyalty": {
        ".validate": "newData.hasChildren(['every'])",
        "every": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50 && newData.val() % 1 === 0" },
        "since": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    "scheduleExceptions": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".validate": "newData.hasChildren()",
      "$date": {
        ".validate": "$date.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && ((newData.child('closed').val() === true && !newData.child('times').exists()) || (!newData.child('closed').exists() && newData.child('times').hasChildren()))",
        "closed": { ".validate": "newData.val() === true" },
        "times": {
          "$t": { ".validate": "$t.matches(/^([01][0-9]|2[0-3])(00|30)$/) && newData.val() === true" }
        },
        "$other": { ".validate": false }
      }
    },

    "clientNotes": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$phoneKey": {
        ".validate": "$phoneKey.matches(/^[0-9]{10,11}$/) && newData.hasChildren()",
        "notes": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "birthday": { ".validate": "newData.isString() && newData.val().matches(/^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)" },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other": { ".validate": false }
      }
    },

    "expenses": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$month": {
        ".validate": "$month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/)",
        "$id": {
          ".validate": "newData.hasChildren(['label', 'amount'])",
          "label": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
          "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "date": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && newData.val().beginsWith($month)" },
          "createdAt": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "$other": { ".validate": false }
        }
      }
    },

    "loyalty": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$phoneKey": {
        ".read": "auth != null && root.child('clients').child($phoneKey).child('uid').val() === auth.uid",
        ".validate": "$phoneKey.matches(/^[0-9]{10,11}$/)",
        "redeemed": {
          "$id": {
            ".validate": "newData.hasChildren(['date', 'at'])",
            "date": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)" },
            "at": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "waitlist": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$date": {
        ".validate": "$date.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)",
        "$phoneKey": {
          ".read": "auth != null && root.child('clients').child($phoneKey).child('uid').val() === auth.uid",
          ".write": "auth != null && root.child('clients').child($phoneKey).child('uid').val() === auth.uid && (!newData.exists() || (auth.token.email_verified === true || root.child('verifiedExempt').child(auth.uid).exists()))",
          ".validate": "$phoneKey.matches(/^[0-9]{10,11}$/) && newData.hasChildren(['name', 'uid', 'createdAt']) && (root.child('admins').child(auth.uid).exists() || (newData.child('uid').val() === auth.uid && (!data.child('notifiedAt').exists() || newData.child('notifiedAt').val() === data.child('notifiedAt').val())))",
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "createdAt": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "notifiedAt": { ".validate": "root.child('admins').child(auth.uid).exists() && newData.isString() && newData.val().length <= 30" },
          "$other": { ".validate": false }
        }
      }
    },

    "blockedDates": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "blockedTimeSlots": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "contacts": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "clients": {
      ".indexOn": ["email", "uid"],
      ".read": "auth != null && query.orderByChild === 'uid' && query.equalTo === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$phoneKey": {
        ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "root.child('admins').child(auth.uid).exists() || ($phoneKey.matches(/^[0-9]{10,11}$/) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('email').isString() && newData.child('email').val().length <= 254)"
      }
    },

    "appointments": {
      ".indexOn": ["phoneKey"],
      ".read": "auth != null && query.orderByChild === 'phoneKey' && query.equalTo !== null && root.child('clients').child(query.equalTo).child('uid').val() === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('clients').child(data.child('phoneKey').val()).child('uid').val() === auth.uid) && (!newData.exists() || ((auth.token.email_verified === true || root.child('verifiedExempt').child(auth.uid).exists()) && root.child('clients').child(newData.child('phoneKey').val()).child('uid').val() === auth.uid && root.child('bookedSlots').child(newData.child('date').val() + '_' + newData.child('time').val().replace(':', '')).val() === auth.uid))",
        ".validate": "newData.hasChildren(['date', 'time']) && (root.child('admins').child(auth.uid).exists() || (newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('time').val().matches(/^[0-9]{2}:[0-9]{2}$/) && newData.child('service').isString() && newData.child('service').val().length <= 60 && newData.child('name').isString() && newData.child('name').val().length <= 100))",
        "phone": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "rescheduledFrom": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "rescheduledAt": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other": { ".validate": "root.child('admins').child(auth.uid).exists() || $other.matches(/^(name|phoneKey|service|date|time|status)$/)" }
      }
    },

    "cancelledAppointments": {
      ".indexOn": ["phoneKey"],
      ".read": "auth != null && query.orderByChild === 'phoneKey' && query.equalTo !== null && root.child('clients').child(query.equalTo).child('uid').val() === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && !data.exists() && root.child('clients').child(newData.child('phoneKey').val()).child('uid').val() === auth.uid",
        ".validate": "root.child('admins').child(auth.uid).exists() || (newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('time').val().matches(/^[0-9]{2}:[0-9]{2}$/) && newData.child('service').isString() && newData.child('service').val().length <= 60 && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('cancelledBy').val() === 'client')",
        "$other": { ".validate": "root.child('admins').child(auth.uid).exists() || $other.matches(/^(name|phone|phoneKey|service|date|time|email|cancelledAt|cancelledBy)$/) && newData.isString() && newData.val().length <= 254" }
      }
    },

    "appointmentHistory": {
      ".indexOn": ["phoneKey"],
      ".read": "auth != null && query.orderByChild === 'phoneKey' && query.equalTo !== null && root.child('clients').child(query.equalTo).child('uid').val() === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
