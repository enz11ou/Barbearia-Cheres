{
  "rules": {
    ".read": "auth != null && root.child('admins').child(auth.uid).exists()",

    "owner": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((root.child('admins').child(auth.uid).exists() && !newData.exists() && root.child('owner').exists() && $uid !== root.child('owner').val()) || (auth.uid === $uid && !data.exists() && auth.token.email_verified === true && root.child('adminInvites').child(auth.token.email.replace('.', ',')).exists()))",
        ".validate": "newData.isString() && newData.val() === auth.token.email"
      }
    },

    "adminInvites": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$emailKey": {
        ".read": "auth != null && auth.token.email.replace('.', ',') === $emailKey",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!newData.exists() && auth.token.email_verified === true && auth.token.email.replace('.', ',') === $emailKey))",
        ".validate": "$emailKey.matches(/^[a-z0-9_%+,-]+@[a-z0-9,-]+$/) && $emailKey.length <= 254 &&newData.child('email').isString() && newData.child('email').val().replace('.', ',') === $emailKey && newData.child('invitedBy').isString()"
      }
    },

    "verifiedExempt": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "bookedSlots": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$slot": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && (auth.token.email_verified === true || root.child('verifiedExempt').child(auth.uid).exists()) && $slot.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}_(09|1[0-8])(00|30)$/)) || (!newData.exists() && (data.val() === auth.uid || data.val() === true)))"
      }
    },

    "blockedDates": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "blockedTimeSlots": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "contacts": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "clients": {
      ".indexOn": ["email", "uid"],
      ".read": "auth != null && query.orderByChild === 'uid' && query.equalTo === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$phoneKey": {
        ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "root.child('admins').child(auth.uid).exists() || ($phoneKey.matches(/^[0-9]{10,11}$/) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('email').isString() && newData.child('email').val().length <= 254)"
      }
    },

    "appointments": {
      ".indexOn": ["phoneKey"],
      ".read": "auth != null && query.orderByChild === 'phoneKey' && query.equalTo !== null && root.child('clients').child(query.equalTo).child('uid').val() === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('clients').child(data.child('phoneKey').val()).child('uid').val() === auth.uid) && (!newData.exists() || ((auth.token.email_verified === true || root.child('verifiedExempt').child(auth.uid).exists()) && root.child('clients').child(newData.child('phoneKey').val()).child('uid').val() === auth.uid && root.child('bookedSlots').child(newData.child('date').val() + '_' + newData.child('time').val().replace(':', '')).val() === auth.uid))",
        ".validate": "root.child('admins').child(auth.uid).exists() || (newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('time').val().matches(/^[0-9]{2}:[0-9]{2}$/) && newData.child('service').isString() && newData.child('service').val().length <= 60 && newData.child('name').isString() && newData.child('name').val().length <= 100)",
        "phone": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "rescheduledFrom": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "rescheduledAt": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other": { ".validate": "root.child('admins').child(auth.uid).exists() || $other.matches(/^(name|phoneKey|service|date|time|status)$/)" }
      }
    },

    "cancelledAppointments": {
      ".indexOn": ["phoneKey"],
      ".read": "auth != null && query.orderByChild === 'phoneKey' && query.equalTo !== null && root.child('clients').child(query.equalTo).child('uid').val() === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && !data.exists() && root.child('clients').child(newData.child('phoneKey').val()).child('uid').val() === auth.uid",
        ".validate": "root.child('admins').child(auth.uid).exists() || (newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('time').val().matches(/^[0-9]{2}:[0-9]{2}$/) && newData.child('service').isString() && newData.child('service').val().length <= 60 && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('cancelledBy').val() === 'client')",
        "$other": { ".validate": "root.child('admins').child(auth.uid).exists() || $other.matches(/^(name|phone|phoneKey|service|date|time|email|cancelledAt|cancelledBy)$/) && newData.isString() && newData.val().length <= 254" }
      }
    },

    "appointmentHistory": {
      ".indexOn": ["phoneKey"],
      ".read": "auth != null && query.orderByChild === 'phoneKey' && query.equalTo !== null && root.child('clients').child(query.equalTo).child('uid').val() === auth.uid",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
